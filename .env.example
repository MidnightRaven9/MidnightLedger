# Copy to .env for local development. The Android app and the PWA never read
# these values — they are only used by the optional local/dev server and the
# Cloudflare Worker deployment. The shipped app is fully offline.

# Interface the local server binds to (defaults to 127.0.0.1).
HOST=127.0.0.1

# The financial API stays disabled unless this is exactly 1. Registration,
# login and all financial routes remain disabled when it is unset.
# ENABLE_FINANCIAL_API=1

# Comma-separated list of browser origins permitted to call the API.
# The Worker falls back to the production demo + localhost when unset.
# A wildcard is never honoured, even if listed here.
ALLOWED_ORIGINS=https://midnightledger.justicegraff6.workers.dev,http://localhost:5173,http://localhost:3000

# Authentication uses per-account passwords and opaque, hashed bearer tokens.
# There is no shared API secret to configure. Accounts are created through
# POST /api/auth/register while the API is explicitly enabled; tokens are
# returned only by POST /api/auth/login and expire after 24 hours.
